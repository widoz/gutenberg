{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-features-testing/notice",
	"title": "Notice",
	"category": "design",
	"icon": "info-outline",
	"description": "A dismissable notification. The dismiss action runs with the Interactivity API.",
	"keywords": [
		"notice",
		"alert",
		"notification",
		"dismiss"
	],
	"textdomain": "wp-features-testing",
	"supports": {
		"interactivity": true,
		"html": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"content": {
			"type": "string",
			"default": ""
		},
		"dismissLabel": {
			"type": "string",
			"default": "Dismiss"
		}
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style.css",
	"render": "file:./render.php",
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "destructive",
			"label": "Destructive"
		}
	]
}
