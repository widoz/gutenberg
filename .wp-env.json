{
	"$schema": "./schemas/json/wp-env.json",
	"testsEnvironment": false,
	"core": "./development/core",
	"plugins": [
		".",
		"./development/plugins/data-views",
		"./development/plugins/hooked-block",
		"./development/plugins/abilities",
		"./development/plugins/suspended-block",
		"./development/plugins/responsive-block",
		"./development/plugins/interactivity-api",
		"./development/plugins/templates",
		"./development/plugins/block-binding",
		"./development/plugins/wp-build"
	],
	"themes": [ "./test/emptytheme", "./development/themes/twentytwentyfive" ],
	"phpmyadminPort": 9000,
	"mappings": {
		"wp-content/plugins/ai": "https://downloads.wordpress.org/plugin/ai.1.0.1.zip",
		"wp-content/plugins/performance-lab": "https://downloads.wordpress.org/plugin/performance-lab.3.9.0.zip"
	},
	"env": {
