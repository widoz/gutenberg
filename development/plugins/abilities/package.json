{
	"name": "abilities-api",
	"version": "1.0.0",
	"description": "Demonstrates the Abilities API in WordPress.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build:script": "wp-scripts build --config ./webpack.config.js",
		"start:script": "wp-scripts start --config ./webpack.config.js",
		"build:module": "wp-scripts build --experimental-modules --config ./webpack.module.config.js",
		"start:module": "wp-scripts start --experimental-modules --config ./webpack.module.config.js"
	},
	"devDependencies": {
		"@wordpress/scripts": "file:../../../../packages/scripts/"
	},
	"dependencies": {
		"@wordpress/abilities": "file:../../../../packages/abilities/",
		"@wordpress/core-abilities": "file:../../../../packages/core-abilities/",
		"@wordpress/data": "file:../../../../packages/data/",
		"@wordpress/plugins": "file:../../../../packages/plugins/",
		"@wordpress/element": "file:../../../../packages/element/",
		"@wordpress/block-editor": "file:../../../../packages/block-editor/",
		"@wordpress/editor": "file:../../../../packages/editor/",
		"@wordpress/url": "file:../../../../packages/url/",
		"@wordpress/api-fetch": "file:../../../../packages/api-fetch/"
	}
}
