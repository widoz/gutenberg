{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"styles": {
		"color": {
			"background": "var(--wp--custom--ds--color--surface)",
			"text": "var(--wp--custom--ds--color--on-surface)"
		},
		"typography": {
			"fontFamily": "var(--wp--custom--ds--font--family--body)",
			"fontSize": "var(--wp--custom--ds--font--size--body)",
			"fontWeight": "var(--wp--custom--ds--font--weight--normal)",
			"lineHeight": "var(--wp--custom--ds--font--leading--relaxed)",
			"letterSpacing": "var(--wp--custom--ds--font--tracking--normal)"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--custom--ds--space--lg)",
				"right": "var(--wp--custom--ds--space--lg)"
			},
			"blockGap": "var(--wp--custom--ds--space--lg)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--custom--ds--font--family--heading)",
					"fontWeight": "var(--wp--custom--ds--font--weight--semibold)",
					"lineHeight": "var(--wp--custom--ds--font--leading--snug)",
					"letterSpacing": "var(--wp--custom--ds--font--tracking--tight)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--display)",
					"lineHeight": "var(--wp--custom--ds--font--leading--none)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--title)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--lead)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--body)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--body-sm)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--caption)",
					"letterSpacing": "var(--wp--custom--ds--font--tracking--wide)",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--custom--ds--color--accent)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--custom--ds--color--ring)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--custom--ds--color--accent)",
					"text": "var(--wp--custom--ds--color--on-accent)"
				},
				"border": {
					"color": "var(--wp--custom--ds--color--accent)",
					"radius": "var(--wp--custom--ds--radius--md)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--ds--space--sm)",
						"right": "var(--wp--custom--ds--space--md)",
						"bottom": "var(--wp--custom--ds--space--sm)",
						"left": "var(--wp--custom--ds--space--md)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--custom--ds--font--family--body)",
					"fontSize": "var(--wp--custom--ds--font--size--body-sm)",
					"fontWeight": "var(--wp--custom--ds--font--weight--medium)",
					"lineHeight": "var(--wp--custom--ds--font--leading--snug)",
					"letterSpacing": "var(--wp--custom--ds--font--tracking--normal)",
					"textDecoration": "none"
				},
				"shadow": "var(--wp--custom--ds--elevation--rest)",
				":hover": {
					"shadow": "var(--wp--custom--ds--elevation--hover)"
				},
				":focus": {
					"outline": {
						"color": "var(--wp--custom--ds--color--ring)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				},
				":active": {
					"shadow": "var(--wp--custom--ds--elevation--rest)"
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--caption)",
					"lineHeight": "var(--wp--custom--ds--font--leading--normal)"
				},
				"color": {
					"text": "var(--wp--custom--ds--color--on-muted)"
				}
			},
			"cite": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--body-sm)",
					"fontStyle": "normal",
					"fontWeight": "var(--wp--custom--ds--font--weight--medium)"
				},
				"color": {
					"text": "var(--wp--custom--ds--color--on-muted)"
				}
			},
			"label": {
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--body-sm)",
					"fontWeight": "var(--wp--custom--ds--font--weight--medium)",
					"lineHeight": "var(--wp--custom--ds--font--leading--snug)"
				},
				"color": {
					"text": "var(--wp--custom--ds--color--on-surface)"
				}
			},
			"select": {
				"color": {
					"background": "var(--wp--custom--ds--color--surface)",
					"text": "var(--wp--custom--ds--color--on-surface)"
				},
				"border": {
					"color": "var(--wp--custom--ds--color--border)",
					"radius": "var(--wp--custom--ds--radius--md)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--ds--space--sm)",
						"right": "var(--wp--custom--ds--space--md)",
						"bottom": "var(--wp--custom--ds--space--sm)",
						"left": "var(--wp--custom--ds--space--md)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--custom--ds--font--family--body)",
					"fontSize": "var(--wp--custom--ds--font--size--body-sm)",
					"lineHeight": "var(--wp--custom--ds--font--leading--snug)"
				}
			},
			"textInput": {
				"color": {
					"background": "var(--wp--custom--ds--color--surface)",
					"text": "var(--wp--custom--ds--color--on-surface)"
				},
				"border": {
					"color": "var(--wp--custom--ds--color--border)",
					"radius": "var(--wp--custom--ds--radius--md)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--ds--space--sm)",
						"right": "var(--wp--custom--ds--space--md)",
						"bottom": "var(--wp--custom--ds--space--sm)",
						"left": "var(--wp--custom--ds--space--md)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--custom--ds--font--family--body)",
					"fontSize": "var(--wp--custom--ds--font--size--body-sm)",
					"lineHeight": "var(--wp--custom--ds--font--leading--snug)"
				}
			}
		}
	}
}
