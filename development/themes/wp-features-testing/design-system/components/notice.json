{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"blocks": {
			"wp-features-testing/notice": {
				"color": {
					"custom": false
				}
			}
		}
	},
	"styles": {
		"blocks": {
			"wp-features-testing/notice": {
				"color": {
					"background": "var(--wp--custom--ds--color--surface)",
					"text": "var(--wp--custom--ds--color--on-surface)"
				},
				"border": {
					"color": "var(--wp--custom--ds--color--border)",
					"radius": "var(--wp--custom--ds--radius--lg)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--ds--space--md)",
						"right": "var(--wp--custom--ds--space--md)",
						"bottom": "var(--wp--custom--ds--space--md)",
						"left": "var(--wp--custom--ds--space--md)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--custom--ds--font--size--body-sm)",
					"lineHeight": "var(--wp--custom--ds--font--leading--snug)"
				},
				"shadow": "var(--wp--custom--ds--elevation--rest)"
			}
		}
	}
}
