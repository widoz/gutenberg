{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"custom": {
			"ds": {
				"color": {
					"page": "#ffffff",
					"surface": "#ffffff",
					"on-surface": "#09090b",
					"muted": "#f4f4f5",
					"on-muted": "#71717a",
					"border": "#e4e4e7",
					"ring": "#a1a1aa",
					"accent": "#18181b",
					"on-accent": "#fafafa",
					"danger": "#dc2626",
					"danger-surface": "#fef2f2",
					"highlight": "#fef08a",
					"on-highlight": "#09090b",
					"red": "#dc2626"
				},
				"font": {
					"family": {
						"body": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
						"heading": "var(--wp--custom--ds--font--family--body)",
						"mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace"
					},
					"size": {
						"caption": "0.75rem",
						"body-sm": "0.875rem",
						"body": "1rem",
						"lead": "1.125rem",
						"title": "1.5rem",
						"display": "2.25rem"
					},
					"weight": {
						"normal": "400",
						"medium": "500",
						"semibold": "600"
					},
					"leading": {
						"none": "1",
						"snug": "1.25",
						"normal": "1.5",
						"relaxed": "1.65"
					},
					"tracking": {
						"tight": "-0.02em",
						"normal": "0",
						"wide": "0.025em"
					}
				},
				"space": {
					"xxs": "0.25rem",
					"xs": "0.5rem",
					"sm": "0.75rem",
					"md": "1rem",
					"lg": "1.5rem",
					"xl": "2rem",
					"xxl": "3rem"
				},
				"radius": {
					"sm": "0.25rem",
					"md": "0.375rem",
					"lg": "0.5rem"
				},
				"motion": {
					"duration": "120ms",
					"easing": "cubic-bezier(0.4, 0, 0.2, 1)"
				},
				"elevation": {
					"rest": "0 1px 2px 0 rgba(9, 9, 11, 0.05)",
					"raised": "0 4px 6px -1px rgba(9, 9, 11, 0.1), 0 2px 4px -2px rgba(9, 9, 11, 0.1)",
					"hover": "0 10px 15px -3px rgba(9, 9, 11, 0.1), 0 4px 6px -4px rgba(9, 9, 11, 0.1)",
					"lift": "-2px"
				},
				"layout": {
					"content": "40rem",
					"wide": "64rem"
				}
			}
		}
	}
}
