{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"styles": {
		"blocks": {
			"core/quote": {
				"color": {
					"text": "var(--wp--custom--ds--color--on-muted)"
				},
				"border": {
					"left": {
						"color": "var(--wp--custom--ds--color--border)",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--custom--ds--space--md)"
					}
				},
				"typography": {
					"fontStyle": "italic",
					"lineHeight": "var(--wp--custom--ds--font--leading--relaxed)"
				}
			}
		}
	}
}
